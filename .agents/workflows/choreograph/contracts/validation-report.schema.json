{
  "type": "object",
  "required": ["name", "packagePath", "ready", "scope", "invocationCount", "diagnostics", "semanticChecks"],
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "packagePath": { "type": "string", "minLength": 1 },
    "ready": { "type": "boolean" },
    "scope": { "const": "package-discovery-and-static-review" },
    "invocationCount": { "type": "integer", "minimum": 1, "maximum": 3 },
    "diagnostics": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "semanticChecks": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}

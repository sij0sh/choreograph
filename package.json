{
  "name": "pi-workflows",
  "version": "0.1.0",
  "description": "A pi coding-agent extension that runs stepped workflows from markdown definitions below the agent directory",
  "license": "MIT",
  "private": true,
  "type": "module",
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "tsc -p tsconfig.json && tsc -p tsconfig.src.json && node --test \"*.test.mjs\" \"test/**/*.test.mjs\""
  },
  "dependencies": {
    "typebox": "~1.3.7",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "~0.84.2",
    "@types/node": "^26.2.0",
    "typescript": "~7.0.2"
  }
}

{
  "name": "choreograph",
  "version": "0.2.0",
  "description": "A pi coding-agent extension that runs stepped workflows from markdown definitions below the agent directory",
  "keywords": ["pi-package"],
  "license": "MIT",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sij0sh/choreograph.git"
  },
  "bugs": {
    "url": "https://github.com/sij0sh/choreograph/issues"
  },
  "homepage": "https://github.com/sij0sh/choreograph#readme",
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "tsc -p tsconfig.json --incremental --tsBuildInfoFile node_modules/.cache/choreograph/tsconfig.tsbuildinfo && node --test \"test/**/*.test.mjs\"",
    "test:unit": "node --test \"test/**/*.test.mjs\""
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "~0.84.2",
    "@earendil-works/pi-tui": "~0.84.2",
    "@types/node": "^26.2.0",
    "typebox": "~1.3.7",
    "typescript": "~7.0.2"
  }
}
